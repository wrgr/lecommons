---
/**
 * Explore page: an interactive knowledge graph that reconfigures around a chosen
 * learner journey or competency, linking lecommons topics + resources to the
 * lebokai (LEBOK) Knowledge Area pages that ground them pedagogically.
 */

import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

// @ts-ignore — JSON imports
import topicMap from "../data/topic_map.json";
// @ts-ignore
import knowledgeSeeds from "../data/knowledge_graph_seeds.json";
// @ts-ignore
import pathwaysData from "../data/pathways.json";
// @ts-ignore
import learnerJourneys from "../data/learner_journeys.json";
// @ts-ignore
import competenciesData from "../data/competencies.json";
// @ts-ignore — vendored copy of lebokai's public/graph-nodes.json (run scripts/sync_lebokai_nodes.py)
import lebokNodes from "../data/lebokai_nodes.json";
// @ts-ignore
import ppRegistry from "../data/programs_people_registry.json";

import { topicUrl } from "../data/topicSlugs";

const base = import.meta.env.BASE_URL;

// LEBOK wiki base (same public URL used in index.astro / Base.astro).
const LEBOK_URL = "https://wrgr.github.io/lebokai";

// ── Topic nodes ────────────────────────────────────────────────────────────
const topics = (topicMap as any[]).map((t) => ({
  id: t.topic_code,
  label: t.topic_name,
  layer: t.layer,
  description: t.why_it_matters,
}));

// ── Topic→topic edges (prerequisite + strongly-related), as in graph.astro ──
const topicEdges = (knowledgeSeeds as any[])
  .filter((e) => e.node_type === "TOPIC" && (e.edge_type === "PREREQ_FOR" || e.edge_type === "STRONGLY_RELATED"))
  .map((e) => ({ source: e.node_id, target: e.edge_target, type: e.edge_type }));

// ── lebokai page nodes (from the vendored manifest) ─────────────────────────
// A node is a leaf when no other node names it as parent.
const parentSlugs = new Set((lebokNodes as any[]).map((n) => n.parent).filter(Boolean));
const lebok = (lebokNodes as any[]).map((n) => ({
  id: `lebok:${n.slug}`,
  label: n.title,
  topics: n.topics ?? [],
  description: n.graph_description ?? "",
  href: n.href,
  kaNumber: n.ka_number ?? null,
  // Overview view shows only Knowledge Area landing pages (top-level nodes).
  isKa: n.parent === null && String(n.slug).startsWith("knowledge-area"),
  isLeaf: !parentSlugs.has(n.slug),
}));

// ── Topic → site resource items (same pattern as graph.astro) ───────────────
function entryAnchorId(slug: string): string {
  return `entry-${slug.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
}
const collectionLabels: Record<string, string> = {
  practice: "Practice", tools: "Tools", "reading-list": "Reading List",
  events: "Events", community: "Community",
};
const allItems = [
  ...(await getCollection("practice")),
  ...(await getCollection("tools")),
  ...(await getCollection("reading-list")),
  ...(await getCollection("events")),
  ...(await getCollection("community")),
];
const topicItems: Record<string, { title: string; href: string; external: boolean; collection: string }[]> = {};
for (const item of allItems) {
  const d = item.data as any;
  for (const t of d.topics ?? []) {
    if (!topicItems[t]) topicItems[t] = [];
    const hasExternal = typeof d.url === "string" && /^https?:\/\//.test(d.url);
    topicItems[t].push({
      title: d.title ?? item.id,
      href: hasExternal ? d.url : `${topicUrl(t)}#${entryAnchorId(item.slug ?? item.id)}`,
      external: hasExternal,
      collection: collectionLabels[item.collection] ?? item.collection,
    });
  }
}
for (const code of Object.keys(topicItems)) {
  topicItems[code].sort((a, b) => a.collection.localeCompare(b.collection) || a.title.localeCompare(b.title));
}

// ── Standards lookup (for competency documentation links) ───────────────────
const standards: Record<string, { name: string; url: string }> = {};
for (const r of ppRegistry as any[]) {
  if (r.content_type === "SG") standards[r.resource_id] = { name: r.name, url: r.url ?? "" };
}

// ── Selections: four focus groups ───────────────────────────────────────────
// Learner journeys (staged, from the archive import).
const learnerJourneySelections = (learnerJourneys as any[]).map((j) => ({
  id: j.id, kind: "journey" as const, label: j.title, description: j.learner_type,
  pedagogy: "", role: j.role, topics: j.topics ?? [], concepts: j.concepts ?? [], standards: [],
}));
// Thematic pathways (narrative threads).
const pathwaySelections = (pathwaysData as any[]).map((p) => ({
  id: p.id, kind: "pathway" as const, label: p.title, description: p.description,
  pedagogy: p.pedagogy ?? "", theme: p.theme, topics: p.topics ?? [], concepts: [], standards: [],
}));
const competencySelections = (competenciesData as any[]).map((c) => ({
  id: c.id, kind: "competency" as const, label: c.title, description: c.description,
  pedagogy: c.pedagogy ?? "", topics: c.topics ?? [], concepts: c.concepts ?? [], standards: c.standards ?? [],
}));
// Roles (learner-type axis): union each role's journeys' topics/concepts.
const roleMap = new Map<string, any>();
for (const j of learnerJourneys as any[]) {
  const key = j.role;
  const r = roleMap.get(key) ?? {
    id: `role-${key.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`, kind: "role" as const,
    label: key, description: j.learner_type, pedagogy: "", topics: [], concepts: [], standards: [],
  };
  for (const t of j.topics ?? []) if (!r.topics.includes(t)) r.topics.push(t);
  for (const c of j.concepts ?? []) if (!r.concepts.includes(c)) r.concepts.push(c);
  roleMap.set(key, r);
}
const roleSelections = [...roleMap.values()];
const selections = [
  ...learnerJourneySelections, ...pathwaySelections, ...competencySelections, ...roleSelections,
];

// Focus groups drive the horizontal filter bar above the graph. Each group has
// a brief academic description and a plain-language practitioner description;
// the active site lens (html[data-audience]) decides which shows. The journey
// group is flagged as the practitioner starting point.
const focusGroups = [
  {
    key: "journey",
    label: "Learner journeys",
    descAcademic: "Staged progressions a specific learner moves through.",
    descPractitioner: "Start from a real learner's path and see what to teach next.",
    practitionerStart: true,
    items: learnerJourneySelections,
  },
  {
    key: "theme",
    label: "Themes",
    descAcademic: "Narrative threads that cut across several topics.",
    descPractitioner: "Use when your problem spans more than one area.",
    practitionerStart: false,
    items: pathwaySelections,
  },
  {
    key: "competency",
    label: "Competencies",
    descAcademic: "Skills mapped to topics and standards.",
    descPractitioner: "Target one specific skill you need people to build.",
    practitionerStart: false,
    items: competencySelections,
  },
  {
    key: "role",
    label: "By role",
    descAcademic: "Topics unioned across a role's journeys.",
    descPractitioner: "Filter to what your role actually has to do.",
    practitionerStart: false,
    items: roleSelections,
  },
];

const exploreData = { topics, lebok, topicEdges, topicItems, selections, standards, wikiBase: LEBOK_URL };
---

<Base title="Explore · Learning Engineering Commons" active="explore">
  <section class="hero">
    <div class="container">
      <div class="eyebrow">Explore</div>
      <h1>Learner journeys through the knowledge graph</h1>
      <p class="subhead">
        Pick a learner journey, theme, competency, or role to reconfigure the graph
        around the topics it touches — surfacing the specific LEBOK topic pages and
        the lecommons resources that ground it. Click any page node for its content,
        evidence, and examples.
      </p>
      <p class="audience-guidance audience-guidance--academic">
        <strong>Academic lens:</strong> trace how each journey, theme, or competency maps to topics, LEBOK pages, and the evidence behind them.
      </p>
      <p class="audience-guidance audience-guidance--practitioner">
        <strong>Practitioner lens:</strong> start from a learner, role, or problem and get to a concrete next step — with approaches you can adapt for resource-constrained and developing-country settings.
      </p>
      <p class="cross-link">
        Want the concept prerequisite map instead? <a href={base + "graph/"}>See the topic map →</a>
      </p>
    </div>
  </section>

  <div class="explore-layout container-wide">
    <section class="focus-controls" id="explore-controls" aria-label="Focus the graph">
      <div class="focus-heading">
        <div>
          <p class="controls-kicker">
            <span class="lens-academic">Focus the graph</span>
            <span class="lens-practitioner">Start solving</span>
          </p>
          <h2>
            <span class="lens-academic">Reconfigure by journey or competency</span>
            <span class="lens-practitioner">Start from your problem</span>
          </h2>
        </div>
        <button class="sel-btn sel-btn--overview active" data-sel="__all__" type="button">Full overview</button>
      </div>
      <div class="focus-groups">
        {focusGroups.map((grp) => (
          <section class={`focus-group focus-group--${grp.key}`}>
            <div class="focus-group-heading">
              <h3>{grp.label}{grp.practitionerStart && <span class="start-here-pill">Start here</span>}</h3>
              <p class="lens-academic">{grp.descAcademic}</p>
              <p class="lens-practitioner">{grp.descPractitioner}</p>
            </div>
            <div class="sel-list">
              {grp.items.map((s) => (
                <button class="sel-btn" data-sel={s.id} type="button">{s.label}</button>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <div class="explore-main">
      <div class="graph-wrap">
        <svg id="explore-svg" viewBox="0 0 1200 820" xmlns="http://www.w3.org/2000/svg"
          role="img" aria-label="Interactive knowledge graph of learning engineering topics and LEBOK pages"></svg>
      </div>
      <p id="explore-cap" class="explore-cap"></p>
      <div class="legend">
        <span class="legend-item"><svg width="14" height="14"><circle cx="7" cy="7" r="6" fill="#7a4e22"/></svg> Foundation topic</span>
        <span class="legend-item"><svg width="14" height="14"><circle cx="7" cy="7" r="6" fill="#2c5f6f"/></svg> Practice topic</span>
        <span class="legend-item"><svg width="14" height="14"><circle cx="7" cy="7" r="6" fill="#5a6b4a"/></svg> Context topic</span>
        <span class="legend-item"><svg width="14" height="14"><circle cx="7" cy="7" r="5" fill="#c98a3a"/></svg> LEBOK page</span>
      </div>

      {/* Selection / node summary and the retrieved LEBOK page content stack full-width below the graph */}
      <aside id="explore-detail" class="explore-detail"></aside>
      <section id="explore-content" class="explore-content" hidden></section>
    </div>
  </div>

  <script type="application/json" id="explore-data" set:html={JSON.stringify(exploreData)} />
  <script>
    import { initExploreGraph } from "../scripts/focusGraph";
    initExploreGraph();
  </script>
</Base>

<style>
  .hero .container { padding-top: 3rem; padding-bottom: 1rem; }
  .hero h1 { font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 500; margin: 0 0 .8rem; }
  .subhead { font-size: 1rem; color: var(--ink-soft); max-width: 42rem; line-height: 1.55; }
  .cross-link { margin: .7rem 0 0; font-family: var(--sans); font-size: .8rem; color: var(--muted); }
  .cross-link a { color: var(--accent); }

  /* Audience-lens copy toggle (mirrors the graph page): academic is default,
     practitioner copy appears when html[data-audience="practitioner"]. */
  .audience-guidance { margin: .8rem 0 0; max-width: 52rem; font-family: var(--sans); font-size: .82rem; line-height: 1.5; color: var(--muted); }
  .audience-guidance--practitioner { display: none; }
  :global(html[data-audience="practitioner"]) .audience-guidance--academic { display: none; }
  :global(html[data-audience="practitioner"]) .audience-guidance--practitioner { display: block; color: #2c5f6f; }
  .lens-practitioner { display: none; }
  :global(html[data-audience="practitioner"]) .lens-academic { display: none; }
  :global(html[data-audience="practitioner"]) .lens-practitioner { display: revert; }

  /* Single column: the graph gets the full container width (full-frame). */
  .explore-layout { display: block; }

  /* ── Horizontal grouped filter bar above the graph ─────────────────── */
  .focus-controls {
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    overflow: hidden;
  }
  .focus-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid var(--border);
  }
  .controls-kicker {
    margin: 0 0 .2rem;
    font-family: var(--sans);
    font-size: .67rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .focus-heading h2 { margin: 0; font-size: 1.1rem; }
  .focus-groups { display: grid; grid-template-columns: repeat(4, 1fr); }
  .focus-group { padding: .9rem 1rem 1rem; min-width: 0; }
  .focus-group + .focus-group { border-left: 1px solid var(--border); }
  .focus-group-heading { margin-bottom: .6rem; }
  .focus-group-heading h3 { margin: 0 0 .15rem; font-family: var(--sans); font-size: .76rem; }
  .focus-group-heading p { margin: 0; color: var(--muted); font-size: .7rem; line-height: 1.3; }
  .focus-group--journey h3 { color: #7a4e22; }
  .focus-group--theme h3 { color: #2c5f6f; }
  .focus-group--competency h3 { color: #5a6b4a; }
  .focus-group--role h3 { color: #6b4fa0; }

  .sel-list { display: flex; flex-wrap: wrap; gap: .35rem; }
  .sel-btn {
    display: inline-flex; align-items: center; text-align: left;
    background: var(--bg); border: 1px solid var(--border); border-radius: 999px;
    padding: .3rem .6rem; font: inherit; font-size: .72rem; line-height: 1.2;
    color: var(--ink-soft); cursor: pointer;
  }
  .sel-btn:hover { border-color: var(--accent); background: var(--tint-warm); color: var(--accent); }
  .sel-btn.active { background: var(--accent); border-color: var(--accent); color: #fff; font-weight: 600; }
  .sel-btn--overview { flex: 0 0 auto; padding: .4rem .9rem; }

  /* Practitioner emphasis: the learner-journey group is the recommended entry
     point, tinted and flagged only when the practitioner lens is active. */
  .start-here-pill { display: none; }
  :global(html[data-audience="practitioner"]) .focus-group--journey { background: #faf5ee; }
  :global(html[data-audience="practitioner"]) .start-here-pill {
    display: inline-block; margin-left: .4rem; padding: .08rem .4rem;
    border-radius: 999px; background: #7a4e22; color: #fff;
    font-size: .56rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
    vertical-align: middle;
  }

  .explore-main { min-width: 0; }
  .graph-wrap { border: 1px solid var(--border); border-radius: 4px; background: var(--bg); overflow-x: auto; }
  .graph-wrap svg { display: block; width: 100%; height: auto; min-width: 640px; }
  .explore-cap { font-family: var(--sans); font-size: .75rem; color: var(--muted); margin: .5rem 0 0; }
  .legend { display: flex; flex-wrap: wrap; gap: .5rem 1.1rem; padding: .7rem 0; font-family: var(--sans); font-size: .74rem; color: var(--muted); }
  .legend-item { display: inline-flex; align-items: center; gap: .35rem; }

  .explore-detail { margin-top: 1rem; border: 1px solid var(--border); border-radius: 4px; padding: 1rem 1.2rem; background: var(--tint); font-family: var(--sans); font-size: .85rem; }
  .explore-detail:empty { display: none; }
  .explore-detail :global(h3) { font-family: var(--serif); font-size: 1.05rem; margin: .3rem 0 .4rem; }
  .explore-detail :global(h4) { font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: .9rem 0 .3rem; }
  .explore-detail :global(p) { color: var(--ink-soft); line-height: 1.5; margin: 0 0 .5rem; }
  .explore-detail :global(.ex-muted) { color: var(--muted); font-style: italic; }
  .explore-detail :global(.ex-ped) { background: var(--tint); border-left: 2px solid var(--accent); padding: .5rem .6rem; border-radius: 0 3px 3px 0; }
  .explore-detail :global(.ex-chip) { display: inline-block; font-size: .62rem; text-transform: uppercase; letter-spacing: .07em; padding: .12rem .45rem; border-radius: 3px; background: var(--accent-2, #5a6b4a); color: #fff; }
  .explore-detail :global(.ex-chip--lebok) { background: #c98a3a; }
  .explore-detail :global(.ex-chip--sel) { background: var(--accent); }
  .explore-detail :global(.ex-list) { list-style: none; margin: 0; padding: 0; }
  .explore-detail :global(.ex-list li) { padding: .2rem 0; border-bottom: 1px solid var(--border); line-height: 1.35; }
  .explore-detail :global(.ex-list li:last-child) { border-bottom: none; }
  .explore-detail :global(.ex-meta) { font-size: .64rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }

  :global(.ex-edge) { stroke: var(--muted); stroke-width: 1; opacity: .3; }
  :global(.ex-edge--prereq_for) { opacity: .45; }
  :global(.ex-edge--covers) { stroke-dasharray: 3 3; opacity: .22; }
  :global(.ex-node) { cursor: pointer; }
  :global(.ex-node:hover circle) { filter: drop-shadow(0 0 4px rgba(0,0,0,.3)); }
  :global(.ex-label) { font-family: var(--sans); fill: var(--ink-soft); pointer-events: none; }
  :global(.ex-label--topic) { font-size: 11px; font-weight: 600; }
  :global(.ex-label--lebok) { font-size: 9px; }

  /* ── Inline LEBOK content panel (below the graph) ─────────────────── */
  .explore-content {
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    background: var(--tint);
    padding: 1.1rem 1.3rem;
  }
  .explore-content :global(.ex-content-title) { font-family: var(--serif); font-size: 1.25rem; font-weight: 600; margin: 0 0 .3rem; }
  .explore-content :global(.ex-content-ext) { margin: 0 0 .8rem; font-family: var(--sans); font-size: .82rem; }
  .explore-content :global(.ex-content-body) { max-width: var(--measure); line-height: 1.6; color: var(--ink-soft); }
  .explore-content :global(.ex-content-body h3),
  .explore-content :global(.ex-content-body h4),
  .explore-content :global(.ex-content-body h5) { font-family: var(--serif); color: var(--ink); margin: 1.1rem 0 .4rem; line-height: 1.3; }
  .explore-content :global(.ex-content-body h3) { font-size: 1.05rem; }
  .explore-content :global(.ex-content-body h4) { font-size: .95rem; }
  .explore-content :global(.ex-content-body h5) { font-size: .88rem; }
  .explore-content :global(.ex-content-body p) { margin: 0 0 .7rem; }
  .explore-content :global(.ex-content-body ul) { margin: 0 0 .7rem 1.1rem; }
  .explore-content :global(.ex-content-body li) { margin-bottom: .25rem; }
  .explore-content :global(.ex-content-body a),
  .explore-content :global(.ex-content-ext a) { color: var(--accent); }
  .explore-content :global(.ex-muted) { color: var(--muted); font-style: italic; }
  .explore-content :global(.ex-refs-heading) { font-family: var(--serif); font-size: 1rem; margin: 1.2rem 0 .4rem; }
  .explore-content :global(.ex-refs) { margin: 0 0 0 1.2rem; padding: 0; font-family: var(--sans); font-size: .8rem; color: var(--ink-soft); }
  .explore-content :global(.ex-refs li) { margin-bottom: .3rem; line-height: 1.4; }
  .explore-content :global(.ex-refs a) { color: var(--accent); }

  /* ── Mobile: stack filter groups, keep the graph scrollable ─────────── */
  @media (max-width: 820px) {
    .focus-heading { display: block; padding: .9rem; }
    .focus-heading .sel-btn--overview { margin-top: .6rem; }
    .focus-groups { display: block; }
    .focus-group { padding: .8rem .9rem; }
    .focus-group + .focus-group { border-left: none; border-top: 1px solid var(--border); }
    .sel-list { flex-wrap: wrap; }
  }
  @media (max-width: 640px) {
    .explore-content { padding: .9rem 1rem; }
    .graph-wrap svg { min-width: 560px; }
  }
</style>
