---
/**
 * Experiments page: a card grid of standalone experimental projects and
 * prototypes, each with a short description and an outbound link. These live at
 * their own domains rather than in the content collections, so the data is a
 * small inline array here rather than an MDX collection + schema change.
 *
 * To add, edit, or remove an experiment, update the `experiments` array below.
 */

import Base from "../layouts/Base.astro";
import SectionHero from "../components/SectionHero.astro";

interface Experiment {
  title: string;
  url: string;
  // One- to two-sentence description of what the experiment is and offers.
  description: string;
  // Short label for the domain, shown under the title (e.g. "calibratedjudgment.org").
  host: string;
}

// A single highlighted item shown as a full-width banner across the top of the
// page, above the experiment grid. Links out to a PDF hosted in another repo.
const featuredPaper = {
  title: "Show Your Work",
  url: "https://github.com/wrgr/lens-concentration/blob/main/papers/show-your-work.pdf",
  description:
    "A paper from the LENS concentration on making reasoning visible — showing the work behind judgments rather than only the conclusions.",
};

// Ordered as presented. Descriptions are editorial blurbs — keep them under
// three sentences to match the site's card copy elsewhere.
const experiments: Experiment[] = [
  {
    title: "Calibrated Judgment",
    url: "https://calibratedjudgment.org/",
    host: "calibratedjudgment.org",
    description:
      "A practice environment for sharpening calibrated judgment — making probabilistic estimates and confidence calls, then checking them against outcomes to close the feedback loop.",
  },
  {
    title: "ExpertTrace",
    url: "https://experttrace.org",
    host: "experttrace.org",
    description:
      "A transfer-oriented learning experiment that surfaces expert reasoning traces, so learners can study how experts work through a problem rather than only seeing the final answer.",
  },
  {
    title: "NeuroTrailblazers",
    url: "https://neurotrailblazers.org",
    host: "neurotrailblazers.org",
    description:
      "A research-incubator platform for mapping the brain at synaptic resolution, offering structured training pathways and mentorship that build research-ready skills in connectomics.",
  },
  {
    title: "Pop",
    url: "https://wrgr.github.io/pop",
    host: "wrgr.github.io/pop",
    description:
      "An experimental prototype exploring interactive learning ideas.",
  },
  {
    title: "grayroncal.com",
    url: "https://grayroncal.com",
    host: "grayroncal.com",
    description:
      "Personal site and portfolio of William Gray Roncal, gathering projects, writing, and experiments in one place.",
  },
];
---

<Base title="Experiments · Learning Engineering Commons" active="experiments">
  <SectionHero
    eyebrow="Experiments"
    title="Prototypes &amp; side projects"
    claim="Standalone experiments — working prototypes and tools that probe ideas at the edges of learning, judgment, and research."
    question="What are we building and testing outside the main corpus?"
    count={experiments.length}
  />

  <a class="featured-banner" href={featuredPaper.url} target="_blank" rel="noopener">
    <div class="container featured-inner">
      <span class="featured-eyebrow">Featured paper</span>
      <span class="featured-title">{featuredPaper.title}</span>
      <span class="featured-desc">{featuredPaper.description}</span>
      <span class="featured-cta">Read the PDF &rarr;</span>
    </div>
  </a>

  <div class="section-grid container">
    <div class="grid">
      {experiments.map((exp) => (
        <article class="card">
          <div class="card-meta">
            <span class="format-chip">Experiment</span>
          </div>
          <h3 class="card-title">
            <a href={exp.url} target="_blank" rel="noopener">{exp.title}</a>
          </h3>
          <p class="card-host">{exp.host}</p>
          <p class="card-summary">{exp.description}</p>
          <p class="card-link">
            <a href={exp.url} target="_blank" rel="noopener">Visit &rarr;</a>
          </p>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  /* Full-width featured banner across the top, above the grid. The whole
     banner is a link; a warm tint + accent border sets it apart from cards. */
  .featured-banner {
    display: block;
    border: none;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(40rem 12rem at 8% 120%, var(--tint-warm) 0%, transparent 70%),
      var(--tint);
  }
  .featured-inner {
    display: grid;
    grid-template-columns: auto;
    gap: .35rem;
    padding-top: 1.4rem;
    padding-bottom: 1.4rem;
  }
  .featured-banner:hover { background: var(--tint-warm); }
  .featured-eyebrow {
    font-family: var(--sans);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .featured-title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }
  .featured-desc {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.5;
    max-width: var(--measure);
  }
  .featured-cta {
    font-family: var(--sans);
    font-size: .82rem;
    font-weight: 600;
    color: var(--accent);
    margin-top: .1rem;
  }
  .featured-banner:hover .featured-cta { text-decoration: underline; }

  .section-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 2rem;
    padding-bottom: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1rem;
  }

  /* Card styling mirrors components/Card.astro so experiment cards read as
     part of the same system as the collection section pages. */
  .card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: .5rem;
    transition: border-color .15s ease;
  }
  .card:hover { border-color: var(--accent); }

  .card-meta { display: flex; gap: .35rem; flex-wrap: wrap; align-items: center; }
  .format-chip {
    font-family: var(--sans);
    font-size: .68rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .15rem .45rem;
    border-radius: 2px;
    color: var(--accent);
    background: var(--tint-warm);
  }

  .card-title {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }
  .card-title a { color: var(--ink); border-bottom: 1px solid transparent; }
  .card-title a:hover { color: var(--accent); border-bottom-color: var(--accent); }

  .card-host {
    font-family: var(--sans);
    font-size: .75rem;
    color: var(--muted);
    margin: 0;
    word-break: break-word;
  }

  .card-summary {
    font-family: var(--serif);
    font-size: .95rem;
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }

  .card-link { margin: .15rem 0 0; }
  .card-link a {
    font-family: var(--sans);
    font-size: .82rem;
    font-weight: 600;
    color: var(--accent);
  }
  .card-link a:hover { text-decoration: underline; }

  @media (max-width: 520px) {
    .card { padding: .95rem 1rem; }
  }
</style>
