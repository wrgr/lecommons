---
import Base from '../../layouts/Base.astro';
import ontology from '../../../public/ontology/learning-engineering-ontology.json';
const termById = Object.fromEntries(ontology.terms.map(term => [term.id, term]));
const sourceById = Object.fromEntries(ontology.sources.map(source => [source.id, source]));
const relationsFor = (id: string) => ontology.relations.filter(relation => relation.from === id);
---
<Base title="Learning engineering ontology · Learning Engineering Commons" description="A working vocabulary and conceptual model grounded in IEEE ICICLE, connecting learners, challenges, design, evidence and iteration.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="/ontology/json-view.css" />
  </Fragment>
  <div class="container-wide ontology">
    <header class="intro">
      <p class="eyebrow">Shared vocabulary · Working draft {ontology.version}</p>
      <h1>Learning engineering,<br />connected.</h1>
      <p class="lede">A vocabulary for describing the people, problems, methods and evidence involved in supporting learning.</p>
      <div class="draft"><strong>For review.</strong> Grounded in IEEE ICICLE. Definitions and relationships are proposed; this is not an IEEE standard or an ICICLE-endorsed ontology.</div>
      <nav class="page-links" aria-label="On this page"><a href="#vocabulary">Vocabulary</a><a href="#competencies">Competencies</a><a href="#case">Worked example</a><a href="#sources">Sources</a><a href="#record">Formatted JSON</a></nav>
    </header>
    <section class="foundation" aria-labelledby="foundation-heading">
      <div><p class="eyebrow">The foundation</p><h2 id="foundation-heading">Process and practice</h2><p>{ontology.foundation.workingDefinition}</p><p class="source-note">Paraphrase of <a href={sourceById[ontology.foundation.source].url}>ICICLE’s published definition</a>.</p></div>
      <div class="distinctions"><h3>Distinctions that matter</h3><p><strong>Desired ≠ observed.</strong> An intended result is not evidence of achievement.</p><p><strong>Data ≠ evidence ≠ decisions.</strong> Observations need interpretation; choices need a rationale.</p><p><strong>Iteration throughout.</strong> Activities may overlap and revisit earlier work.</p></div>
    </section>
    <div class="model-layout" id="vocabulary">
      <aside class="module-index"><h2>Eight parts of the model</h2><p>{ontology.terms.length} concepts · {ontology.relations.length} relationships</p><nav aria-label="Vocabulary modules">{ontology.modules.map((module, index) => <a href={`#module-${module.id}`}><span>{String(index + 1).padStart(2, '0')}</span>{module.label}</a>)}</nav><a class="small-link" href="#questions">Questions the model should answer</a></aside>
      <div class="vocabulary">{ontology.modules.map((module, index) => <section class="module" id={`module-${module.id}`} aria-labelledby={`heading-${module.id}`}>
        <div class="module-heading"><span>{String(index + 1).padStart(2, '0')}</span><h2 id={`heading-${module.id}`}>{module.label}</h2></div>
        {ontology.terms.filter(term => term.module === module.id).map(term => <article class="term" id={`term-${term.id}`}>
          <h3>{term.label}<a class="permalink" href={`#term-${term.id}`} aria-label={`Link to ${term.label}`}>#</a></h3><p>{term.definition}</p>
          {term.note && <p class="term-note">{term.note}</p>}
          {relationsFor(term.id).length > 0 && <ul class="relations">{relationsFor(term.id).map(relation => <li><span>{relation.label}</span><a href={`#term-${relation.to}`}>{termById[relation.to].label}</a></li>)}</ul>}
          {ontology.specializations.filter(item => item.specific === term.id).map(item => <p class="term-note">A kind of <a href={`#term-${item.general}`}>{termById[item.general].label}</a>.</p>)}
          <p class="term-source">Grounding: {term.sources.map((id, i) => <Fragment>{i > 0 && ' · '}<a href={sourceById[id].url}>{id === 'icicle-process' ? 'ICICLE process' : 'ICICLE resources'}</a></Fragment>)}</p>
        </article>)}
      </section>)}</div>
    </div>
    <section class="extension" id="competencies" aria-labelledby="competencies-heading"><p class="eyebrow">Proposed next extension</p><h2 id="competencies-heading">Make competencies useful through evidence.</h2><p>Competencies can connect the work to team development, role design and assessment. This extension is a proposal for review, not part of ICICLE’s published definition.</p><ol class="competency-chain"><li><strong>Role</strong><span>Who contributes?</span></li><li><strong>Competency</strong><span>What should they be able to do?</span></li><li><strong>Task</strong><span>What work demonstrates it?</span></li><li><strong>Evidence</strong><span>What performance was observed?</span></li></ol><p>Attach context, expected proficiency, assessment criteria, support conditions and provenance. Keep <strong>required competency</strong> separate from <strong>demonstrated proficiency</strong>. A role title, course completion or successful model response alone does not establish competence.</p></section>
    <section class="support" id="questions"><h2>Questions the ontology should answer</h2><ol>{ontology.competencyQuestions.map(question => <li>{question}</li>)}</ol><p class="source-note">These are questions for checking the model’s coverage; they are distinct from people’s competencies.</p></section>
    <section class="support" id="case"><p class="eyebrow">An illustrative case</p><h2>From a challenge to a revision</h2><p class="source-note">Invented workplace example. It illustrates the vocabulary and is not empirical evidence.</p><dl class="case-fields">{Object.entries(ontology.illustrativeCase).filter(([key]) => key !== 'status').map(([key, value]) => <div><dt>{key.replace(/([a-z])([A-Z])/g, '$1 $2')}</dt><dd>{value}</dd></div>)}</dl></section>
    <section class="support" id="sources"><h2>Sources and modeling choices</h2><div class="source-grid">{ontology.sources.map(source => <article><h3><a href={source.url}>{source.title}</a></h3><p>{source.use}</p><p class="source-note">{source.reviewStatus} · reviewed {source.retrieved}</p>{'licenseReportedBySource' in source && <p class="source-note">Source license: <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">{source.licenseReportedBySource}</a>. Definitions here are adapted wording.</p>}</article>)}</div><details><summary>How to interpret this draft</summary><ul>{ontology.modelingConventions.map(item => <li>{item}</li>)}</ul></details><details><summary>Resources to examine next</summary><dl class="case-fields">{ontology.nextSourceReviews.map(item => <div><dt>{item.resource}</dt><dd>{item.purpose}</dd></div>)}</dl></details><details><summary>Open modeling questions</summary><ul>{ontology.openModelingQuestions.map(item => <li>{item}</li>)}</ul></details></section>
    <section class="support" id="record"><h2>The complete record</h2><p>Read the same ontology as expandable fields, or download the original JSON.</p><div class="record-actions"><button id="json-expand" type="button">Expand fields</button><button id="json-collapse" type="button">Collapse fields</button><a href="/ontology/learning-engineering-ontology.json" download>Download JSON</a></div><div id="json-tree" class="json-tree"></div><noscript><p><a href="/ontology/learning-engineering-ontology.json">Open the JSON record</a>.</p></noscript><details class="raw"><summary>Raw JSON, indented</summary><pre><code>{JSON.stringify(ontology, null, 2)}</code></pre></details></section>
    <p class="unlisted">Unlisted working page · available by direct link · excluded from site navigation and search. Unlisted does not mean private.</p>
  </div>
  <script is:inline type="module">
    import {renderJson, toggleBranches} from '/ontology/json-view.js';
    const tree = document.getElementById('json-tree');
    try {
      const response = await fetch('/ontology/learning-engineering-ontology.json');
      if (!response.ok) throw new Error('Record unavailable');
      renderJson(tree, await response.json());
      document.getElementById('json-expand').onclick = () => toggleBranches(tree, true);
      document.getElementById('json-collapse').onclick = () => toggleBranches(tree, false);
    } catch { tree.textContent = 'The formatted record could not load. Use the indented JSON below.'; }
  </script>
</Base>
<style>
  .ontology{max-width:78rem}.intro{padding:1rem 0 2rem}.intro h1{font-size:clamp(2.4rem,5vw,4rem);font-weight:500}.lede{font-size:1.2rem;max-width:45rem}.draft{border-left:3px solid var(--accent);padding:.75rem 1rem;background:var(--tint);font-family:var(--sans);font-size:.95rem;max-width:60rem}.page-links{display:flex;flex-wrap:wrap;gap:.7rem 1.5rem;margin-top:1.4rem;font-family:var(--sans)}.foundation{display:grid;grid-template-columns:1.2fr 1fr;gap:3rem;padding:2rem 0;border-block:1px solid var(--border)}.foundation p{font-size:1.1rem}.foundation .source-note{font-size:.9rem}.distinctions p{font-size:1rem}.model-layout{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:3rem;margin:3rem 0}.module-index{position:sticky;top:6rem;align-self:start;font-family:var(--sans)}.module-index h2{font-size:1.1rem}.module-index p{font-size:.9rem;color:var(--muted)}.module-index nav{display:grid}.module-index nav a{display:flex;gap:.8rem;padding:.65rem 0;border-bottom:1px solid var(--border);font-size:.95rem}.module-index nav span,.module-heading>span{color:var(--muted);font-family:var(--mono);font-size:.9rem}.small-link{display:block;margin-top:1.2rem;font-size:.9rem}.module{margin-bottom:2.5rem;scroll-margin-top:7rem}.module-heading{display:flex;gap:1rem;align-items:baseline;border-bottom:2px solid var(--ink);padding-bottom:.6rem}.module-heading h2{margin:0;font-size:1.5rem}.term{padding:1.25rem 0;border-bottom:1px solid var(--border);scroll-margin-top:7rem}.term h3{font-size:1.2rem}.term p{max-width:none;margin-bottom:.5rem}.term .term-note{color:var(--muted);font-size:.95rem}.permalink{font-family:var(--sans);color:var(--muted);margin-left:.7rem;font-size:.9rem}.relations{margin:.8rem 0;padding:0;list-style:none;display:flex;gap:.45rem .8rem;flex-wrap:wrap;font-family:var(--sans);font-size:.9rem}.relations li{padding:.4rem .6rem;background:var(--tint);display:flex;flex-wrap:wrap;gap:.4rem}.relations li span{color:var(--muted)}.term .term-source{font-size:.85rem;font-family:var(--sans);margin:.7rem 0 0;color:var(--muted)}.extension{background:var(--tint);padding:2rem;border-left:3px solid var(--accent)}.extension p{max-width:65rem}.competency-chain{display:grid;grid-template-columns:repeat(4,1fr);padding:0;list-style:none;gap:1.2rem;margin:1.5rem 0}.competency-chain li{border-top:2px solid var(--accent);padding-top:.8rem}.competency-chain strong,.competency-chain span{display:block}.competency-chain span{font-family:var(--sans);font-size:.95rem}.support{border-top:1px solid var(--border);padding-top:2rem;margin-top:2.5rem;scroll-margin-top:7rem}.support li{margin-bottom:.6rem}.support p{max-width:62rem}.source-note{font-family:var(--sans);font-size:.9rem;color:var(--muted)}.case-fields{margin:1.5rem 0}.case-fields>div{display:grid;grid-template-columns:12rem minmax(0,1fr);gap:1rem;border-bottom:1px solid var(--border);padding:.85rem 0}.case-fields dt{text-transform:capitalize;font-family:var(--sans);font-weight:600}.case-fields dd{margin:0}.source-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.support>details{padding:1rem 0;border-top:1px solid var(--border)}summary{cursor:pointer;font-family:var(--sans);font-weight:600}.record-actions{display:flex;align-items:center;flex-wrap:wrap;gap:.7rem;margin:1rem 0;font-family:var(--sans)}button{font:inherit;padding:.5rem .8rem;border:1px solid var(--border);border-radius:4px;background:var(--bg);color:var(--ink);cursor:pointer}.raw{margin-top:1.5rem}.raw pre{max-height:36rem;font-size:.9rem}.unlisted{font-family:var(--sans);font-size:.85rem;color:var(--muted);margin-top:3rem;max-width:none}:is(a,button,summary):focus-visible{outline:2px solid var(--accent);outline-offset:4px}@media(max-width:850px){.model-layout{grid-template-columns:1fr;gap:2rem}.module-index{position:static}.module-index nav{grid-template-columns:1fr 1fr;gap:0 1rem}.foundation{grid-template-columns:1fr;gap:1rem}.competency-chain{grid-template-columns:1fr 1fr}.source-grid{grid-template-columns:1fr;gap:1rem}}@media(max-width:520px){.module-index nav{grid-template-columns:1fr}.case-fields>div{grid-template-columns:1fr;gap:.3rem}.extension{padding:1.2rem}.competency-chain{grid-template-columns:1fr}.intro h1{font-size:2.4rem}}
</style>
