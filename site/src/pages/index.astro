---
// Homepage: a light "reference-library" landing for the Learning Engineering
// Commons — the field's shared, topic-linked evidence corpus. It uses the
// default light Base shell and the site's serif/sans type so the landing reads
// as a practical field resource consistent with the interior pages, rather than
// a dark editorial scroll experience. The messaging is unchanged; only the
// look and feel is light and utilitarian.
import Base from "../layouts/Base.astro";

const base = import.meta.env.BASE_URL;
const CAPABILITYMATTERS_URL = "https://capabilitymatters.org/";
const ICICLE_URL = "https://sagroups.ieee.org/icicle/";
const LEBOK_URL = "https://wrgr.github.io/lebokai/";

// The "why this exists" argument, kept verbatim from the prior homepage.
const argument = [
  {
    n: "01",
    heading: "Practitioners define the field differently depending on where they <em>found it.</em>",
    body: "A conference talk. A standards committee. A blog post. The vocabulary doesn't converge. A claim made in one venue rarely gets traced back to its evidence, and the evidence rarely links forward to where it's actually used.",
  },
  {
    n: "02",
    heading: "So every topic here links to <em>what backs it up.</em>",
    body: "Seed papers. Expansion literature pulled from the wider citation graph. And the non-paper resources — programs, people, conferences, tools, organizations — that make the claim operational, not just cited.",
  },
  {
    n: "03",
    heading: "Curated, then filtered, then <em>verified.</em>",
    body: "Corpus filters, cross-seed scoring, and human review keep the noise out. What's here is meant to hold up when someone checks it.",
  },
  {
    n: "04",
    heading: "This is a reference, <em>not a pitch.</em>",
    body: "No claim without a source. No resource without a link back to where it came from. When ICICLE and this site differ on a definition, ICICLE wins.",
  },
];

// The three headline corpus counts, kept verbatim.
const stats = [
  {
    num: "340+",
    unit: "people, programs & institutions",
    body: "Tracked across the field — practitioners, degree programs, standards bodies, and the organizations that convene them.",
    cite: "Programs & people registry · updated continuously",
  },
  {
    num: "247",
    unit: "resources indexed",
    body: "Papers, tools, talks, and frameworks spanning practice, the reading list, events, and tools — plus the community roster.",
    cite: "Practice + tools + reading list + events + community",
  },
  {
    num: "18",
    unit: "topics, three layers",
    body: "From foundational learning science through practice methods to the high-consequence domains the field operates in.",
    cite: "Foundation → Practice → Context",
  },
];
---

<Base
  title="Learning Engineering Commons"
  description="The field's shared, topic-linked evidence corpus — practice, tools, reading list, events, and community, including material from IEEE ICICLE."
  active="welcome"
>
  <section class="hp-hero">
    <div class="container-wide">
      <p class="eyebrow">Learning Engineering Commons</p>
      <h1 class="hp-title">The field, <em>traced to its sources</em></h1>
      <p class="hp-sub">
        Learning engineering is scattered across conferences, standards bodies, and grey literature.
        This is where it's linked together — topic by topic, claim by claim.
      </p>
      <div class="hp-actions">
        <a href={base + "topics/"} class="btn btn-primary">Browse by topic</a>
        <a href={base + "graph/"} class="btn btn-ghost">Open the topic map</a>
        <a href={base + "search/"} class="btn btn-ghost">Search the corpus</a>
      </div>
    </div>
  </section>

  <section class="hp-argument" id="argument">
    <div class="container-wide">
      <p class="eyebrow">Why this exists</p>
      <div class="arg-grid">
        {argument.map((a) => (
          <article class="arg-item">
            <span class="arg-num">{a.n}</span>
            <div>
              <h2 set:html={a.heading} />
              <p>{a.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="hp-evidence">
    <div class="container-wide">
      <div class="stat-row">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat-num">{s.num}</div>
            <div class="stat-unit">{s.unit}</div>
            <p>{s.body}</p>
            <div class="stat-cite">{s.cite}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hp-domains" id="domains">
    <div class="container-wide">
      <div class="hp-section-head">
        <h2>What's in the corpus</h2>
        <p>Four ways into the same evidence base.</p>
      </div>
      <div class="domain-grid">
        <a class="domain-card" href={base + "practice/"}>
          <div class="icon" aria-hidden="true">▤</div>
          <h3>Practice</h3>
          <p>Process diagrams, frameworks, and templates learning engineers actually use.</p>
        </a>
        <a class="domain-card" href={base + "tools/"}>
          <div class="icon" aria-hidden="true">⚒</div>
          <h3>Tools &amp; Standards</h3>
          <p>The platforms and interoperability specs the field builds on — xAPI, Caliper, DataShop, and more.</p>
        </a>
        <a class="domain-card" href={base + "community/"}>
          <div class="icon" aria-hidden="true">◈</div>
          <h3>Community</h3>
          <p>Institutions, programs, conferences, and the people doing the work — including the IEEE ICICLE network.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="hp-cta" id="connect">
    <div class="container">
      <h2>One shared record beats a hundred <em>private</em> ones.</h2>
      <p>Browse by topic or search across the whole corpus. Developed in collaboration with IEEE ICICLE by LENS faculty at Johns Hopkins.</p>
      <div class="hp-actions hp-actions--center">
        <a href={base + "topics/"} class="btn btn-primary">Browse by topic</a>
        <a href={CAPABILITYMATTERS_URL} class="btn btn-ghost" target="_blank" rel="noopener">See LENS at Johns Hopkins</a>
      </div>
      <p class="hp-cta-links">
        <a href={ICICLE_URL} target="_blank" rel="noopener">Learn about IEEE ICICLE, the field's professional home</a>
        · <a href={LEBOK_URL} target="_blank" rel="noopener">Explore LEBoK, the field's curricular structure</a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ──────────────────────────────────────────────────────────── */
  .hp-hero {
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(42rem 20rem at 92% -25%, var(--tint-warm) 0%, transparent 70%),
      var(--tint);
  }
  .hp-hero .container-wide { padding-top: 4rem; padding-bottom: 3.4rem; }
  .hp-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2.3rem, 5vw, 3.9rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 1.1rem;
    max-width: 18ch;
  }
  .hp-title em { font-style: italic; color: var(--accent); }
  .hp-sub {
    font-family: var(--sans);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 40rem;
    margin: 0 0 2rem;
  }

  /* ── Buttons (shared by hero + CTA) ────────────────────────────────── */
  .hp-actions { display: flex; flex-wrap: wrap; gap: .7rem; }
  .hp-actions--center { justify-content: center; }
  .btn {
    display: inline-block;
    font-family: var(--sans);
    font-size: .8rem;
    font-weight: 500;
    letter-spacing: .03em;
    padding: .6rem 1.25rem;
    border-radius: 3px;
    border: 1px solid var(--accent);
    transition: background .15s ease, color .15s ease, border-color .15s ease;
  }
  .btn-primary { background: var(--accent); color: #fff; }
  .btn-primary:hover { background: #294066; border-color: #294066; color: #fff; }
  .btn-ghost { background: transparent; color: var(--accent); }
  .btn-ghost:hover { background: var(--tint-warm); border-color: var(--accent); color: var(--accent); }

  /* ── Argument ("why this exists") ──────────────────────────────────── */
  .hp-argument { border-bottom: 1px solid var(--border); }
  .hp-argument .container-wide { padding-top: 3rem; padding-bottom: 3rem; }
  .hp-argument .eyebrow { margin-bottom: 1.8rem; }
  .arg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem 3rem;
  }
  .arg-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }
  .arg-num {
    font-family: var(--sans);
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .1em;
    color: var(--accent);
    padding-top: .3rem;
  }
  .arg-item h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    line-height: 1.25;
    margin: 0 0 .55rem;
  }
  .arg-item :global(h2 em) { font-style: italic; color: var(--accent); }
  .arg-item p {
    font-family: var(--sans);
    font-size: .92rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: 34rem;
  }

  /* ── Evidence stats ────────────────────────────────────────────────── */
  .hp-evidence { background: var(--tint); border-bottom: 1px solid var(--border); }
  .hp-evidence .container-wide { padding-top: 2.6rem; padding-bottom: 2.6rem; }
  .stat-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .stat {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.4rem 1.5rem;
  }
  .stat-num {
    font-family: var(--serif);
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }
  .stat-unit {
    font-family: var(--sans);
    font-size: .7rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--accent-2);
    margin: .5rem 0 .85rem;
  }
  .stat p {
    font-family: var(--sans);
    font-size: .88rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0 0 .9rem;
    max-width: none;
  }
  .stat-cite {
    font-family: var(--sans);
    font-size: .7rem;
    color: var(--muted);
    border-top: 1px solid var(--border);
    padding-top: .7rem;
  }

  /* ── Domains ───────────────────────────────────────────────────────── */
  .hp-domains .container-wide { padding-top: 3rem; padding-bottom: 3rem; }
  .hp-section-head { margin-bottom: 1.6rem; }
  .hp-section-head h2 { font-family: var(--serif); font-size: clamp(1.5rem, 3vw, 2rem); margin: 0 0 .4rem; }
  .hp-section-head p { font-family: var(--sans); color: var(--muted); margin: 0; }
  .domain-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .domain-card {
    display: block;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1.6rem 1.5rem;
    color: inherit;
    transition: border-color .15s ease, transform .15s ease;
  }
  .domain-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .domain-card .icon { font-size: 1.6rem; color: var(--accent); line-height: 1; }
  .domain-card h3 { font-family: var(--serif); font-size: 1.25rem; margin: .8rem 0 .5rem; }
  .domain-card p {
    font-family: var(--sans);
    font-size: .9rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: none;
  }

  /* ── CTA ───────────────────────────────────────────────────────────── */
  .hp-cta { background: var(--tint); border-top: 1px solid var(--border); }
  .hp-cta .container { text-align: center; padding-top: 3.6rem; padding-bottom: 3.6rem; }
  .hp-cta h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.2;
    margin: 0 auto .8rem;
    max-width: 32rem;
  }
  .hp-cta :global(h2 em) { font-style: italic; color: var(--accent); }
  .hp-cta > .container > p {
    font-family: var(--sans);
    color: var(--ink-soft);
    margin: 0 auto 1.5rem;
    max-width: 34rem;
  }
  .hp-cta-links {
    font-family: var(--sans);
    font-size: .82rem;
    color: var(--muted);
    max-width: none;
    margin: 1.4rem auto 0;
  }
  .hp-cta-links a { color: var(--accent); }

  /* The CTA is the homepage's final band and shares the footer's tint, so the
     default shell's main padding-bottom (4rem) + footer margin-top (4rem) would
     leave a blank light gap here. Zero both, scoped to pages that render the CTA
     (only the homepage ships this stylesheet, and :has keeps it defensive). */
  :global(main:has(.hp-cta)) { padding-bottom: 0; }
  :global(body:has(.hp-cta) footer) { margin-top: 0; }

  /* ── Responsive ────────────────────────────────────────────────────── */
  @media (max-width: 760px) {
    .arg-grid { grid-template-columns: 1fr; gap: 1.8rem; }
    .stat-row { grid-template-columns: 1fr; }
    .domain-grid { grid-template-columns: 1fr; }
    .hp-hero .container-wide { padding-top: 3rem; padding-bottom: 2.6rem; }
  }
</style>
