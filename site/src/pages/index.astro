---
/* Commons homepage: what the Commons is, a directory of every section with
   live content counts, a LEBOK feature card, and a reference card for the
   LENS lens site (capabilitymatters.org). Light shell like interior pages. */
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL;
const ICICLE_URL = "https://sagroups.ieee.org/icicle/";
// LEBOK links to the wiki repo until the published wiki goes live.
const LEBOK_URL = "https://github.com/wrgr/lebok";
const LENS_URL = "https://capabilitymatters.org";

const counts: Record<string, number> = {};
for (const name of ["reading-list", "practice", "tools", "events", "community", "field-notes"] as const) {
  counts[name] = (await getCollection(name)).length;
}
const totalItems = Object.values(counts).reduce((a, b) => a + b, 0);

const explore = [
  { href: base + "graph/",    title: "Graph",    desc: "The topic–concept map: 18 topics, their concepts, and prerequisite chains." },
  { href: base + "topics/",   title: "Topics",   desc: "Browse the field by topic across Foundation, Practice, and Context layers." },
  { href: base + "pathways/", title: "Pathways", desc: "Guided trails through the resources, from identity to infrastructure." },
  { href: base + "search/",   title: "Search",   desc: "Full-text search across every section of the Commons." },
];

const collections = [
  { href: base + "reading-list/", title: "Reading List", count: counts["reading-list"], desc: "Papers, books, articles, and reports." },
  { href: base + "practice/",     title: "Practice",     count: counts["practice"],     desc: "Process descriptions, methods, and frameworks." },
  { href: base + "tools/",        title: "Tools",        count: counts["tools"],        desc: "Platforms, interoperability specs, and software." },
  { href: base + "events/",       title: "Events",       count: counts["events"],       desc: "Conferences, webinars, talks, and podcasts." },
  { href: base + "community/",    title: "Community",    count: counts["community"],    desc: "People, programs, institutions, and organizations." },
  { href: base + "field-notes/",  title: "Field Notes",  count: counts["field-notes"],  desc: "Editorial syntheses of ideas the field is debating." },
];
---

<Base
  title="Learning Engineering Commons"
  description="A community library for learning engineering: people, programs, papers, tools, and events, adapted from IEEE ICICLE and other community sources."
  active="welcome"
>
  <header class="hero">
    <div class="container">
      <div class="eyebrow">Learning Engineering Commons</div>
      <h1>A community library for the field of learning engineering.</h1>
      <p class="claim">
        {totalItems} curated resources — people, programs, papers, tools, and events — adapted
        from the <a href={ICICLE_URL} target="_blank" rel="noopener">IEEE ICICLE</a> community
        and other public sources, organized around an 18-topic map of the field.
      </p>
    </div>
  </header>

  <section class="container">
    <h2 class="group-heading">Explore the field</h2>
    <div class="card-grid">
      {explore.map((s) => (
        <a class="dir-card" href={s.href}>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
        </a>
      ))}
    </div>

    <h2 class="group-heading">Browse the library</h2>
    <div class="card-grid">
      {collections.map((s) => (
        <a class="dir-card" href={s.href}>
          <h3>{s.title} <span class="count">{s.count}</span></h3>
          <p>{s.desc}</p>
        </a>
      ))}
    </div>

    <h2 class="group-heading">Related projects</h2>
    <div class="feature-grid">
      <a class="feature-card" href={LEBOK_URL} target="_blank" rel="noopener">
        <div class="eyebrow">LEBOK</div>
        <h3>The Learning Engineering Body of Knowledge</h3>
        <p>
          A community-editable reference for what learning engineers need to know — public
          proposals, editorially reviewed. Growing alongside the Commons.
        </p>
      </a>
      <a class="feature-card" href={LENS_URL} target="_blank" rel="noopener">
        <div class="eyebrow">LENS @ JHU</div>
        <h3>Learning Engineering for Next-Generation Systems</h3>
        <p>
          The Johns Hopkins graduate specialization and editorial lens site behind much of this
          curation — the argument for capability as a system parameter.
        </p>
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(36rem 14rem at 95% -10%, var(--tint-warm) 0%, transparent 75%),
      var(--tint);
  }
  .hero .container { padding-top: 3.5rem; padding-bottom: 2.6rem; }
  .hero h1 {
    font-size: clamp(2rem, 4.5vw, 2.8rem);
    font-weight: 500;
    max-width: 36rem;
    margin-bottom: 1rem;
  }
  .claim {
    font-size: clamp(1.02rem, 1.6vw, 1.15rem);
    color: var(--ink-soft);
    max-width: var(--measure);
    margin: 0;
  }

  .group-heading {
    font-size: 1.2rem;
    margin: 2.2rem 0 1rem;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
  }
  .dir-card {
    display: block;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    background: var(--bg);
    color: var(--ink);
    transition: border-color .15s ease, background .15s ease;
  }
  .dir-card:hover {
    border-color: var(--accent);
    background: var(--tint);
    border-bottom-color: var(--accent);
  }
  .dir-card h3 { margin: 0 0 .35rem; font-size: 1.02rem; }
  .dir-card p {
    margin: 0;
    font-family: var(--sans);
    font-size: .85rem;
    color: var(--ink-soft);
    line-height: 1.45;
  }
  .count {
    font-family: var(--sans);
    font-size: .75rem;
    font-weight: 400;
    color: var(--muted);
    margin-left: .25rem;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }
  .feature-card {
    display: block;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 6px;
    padding: 1.2rem 1.3rem;
    background: var(--tint);
    color: var(--ink);
    transition: border-color .15s ease, background .15s ease;
  }
  .feature-card:hover {
    background: var(--tint-warm);
    border-bottom-color: var(--accent);
  }
  .feature-card .eyebrow { margin-bottom: .4rem; }
  .feature-card h3 { margin: 0 0 .4rem; font-size: 1.08rem; }
  .feature-card p {
    margin: 0;
    font-family: var(--sans);
    font-size: .88rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
