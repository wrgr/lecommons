---
// Top navigation. Two parallel renderings:
//   - Desktop (>=900px): plain horizontal <nav class="desktop-nav">
//   - Mobile/tablet (<900px): collapsed <details> disclosure with a hamburger
// Each shows the same link list; CSS swaps which one is visible.
// The site-lens toggle (Researcher / Practitioner — stored internally as
// "academic" / "practitioner") is the only scripted piece.

interface Props {
  active?: string;
}

const { active } = Astro.props;

const base = import.meta.env.BASE_URL;

// Navigation is grouped to cut the "wall of similar tabs" that overwhelms
// newcomers and do-it practitioners:
//   doItems      — the practical sections you reach for to get something done
//   exploreItems — the browse/read views; the four field-map surfaces (Explore,
//                  Graph, Topics, Pathways) are consolidated behind the single
//                  "Explore" hub, so only Explore + the two content lists appear
//                  here, marked "optional" under the practitioner lens
//   metaItems    — About
//   hubItems     — Graph/Topics/Pathways: reached from the Explore hub's
//                  "Browse the field" bar rather than the top nav; kept here
//                  only so the mobile menu can label the current page
const doItems = [
  { href: base,                   label: "Welcome",   slug: "welcome" },
  { href: base + "start/",        label: "Start",     slug: "start" },
  { href: base + "practice/",     label: "Practice",  slug: "practice" },
  { href: base + "tools/",        label: "Tools",     slug: "tools" },
  { href: base + "community/",    label: "Community",   slug: "community" },
  { href: base + "experiments/",  label: "Experiments", slug: "experiments" },
  { href: base + "search/",       label: "Search",      slug: "search" },
];
const exploreItems = [
  { href: base + "explore/",      label: "Explore",      slug: "explore" },
  { href: base + "reading-list/", label: "Reading List", slug: "reading-list" },
  { href: base + "events/",       label: "Events",       slug: "events" },
];
const metaItems = [
  { href: base + "about/",        label: "About",        slug: "about" },
];
const hubItems = [
  { href: base + "graph/",        label: "Graph",        slug: "graph" },
  { href: base + "topics/",       label: "Topics",       slug: "topics" },
  { href: base + "pathways/",     label: "Pathways",     slug: "pathways" },
];

const allItems = [...doItems, ...exploreItems, ...metaItems, ...hubItems];
const activeLabel = allItems.find((it) => it.slug === active)?.label ?? "Menu";
---

<header class="site-nav">
  <div class="nav-inner">
    <a href={base} class="brand" aria-label="Home">
      <span class="brand-mark">LEC</span>
      <span class="brand-text">Learning Engineering Commons</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul class="nav-list">
        {doItems.map((it) => (
          <li>
            <a href={it.href} class:list={[{ active: it.slug === active }, { "nav-cta": it.slug === "start" }]}>{it.label}</a>
          </li>
        ))}
      </ul>
      <span class="nav-sep" aria-hidden="true"></span>
      <span class="nav-group-label" aria-hidden="true">
        <span class="lens-academic">Explore</span>
        <span class="lens-practitioner">Optional</span>
      </span>
      <ul class="nav-list nav-list--explore">
        {exploreItems.map((it) => (
          <li>
            <a href={it.href} class:list={[{ active: it.slug === active }]}>{it.label}</a>
          </li>
        ))}
      </ul>
      <span class="nav-sep" aria-hidden="true"></span>
      <ul class="nav-list">
        {metaItems.map((it) => (
          <li>
            <a href={it.href} class:list={[{ active: it.slug === active }]}>{it.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="audience-toggle" role="group" aria-label="Choose your site lens: researcher or practitioner">
      <span class="audience-label">Site lens</span>
      <button type="button" data-audience-mode="academic" aria-pressed="true">Researcher</button>
      <button type="button" data-audience-mode="practitioner" aria-pressed="false">Practitioner</button>
    </div>

    <details class="mobile-nav">
      <summary aria-label="Toggle navigation menu">
        <span class="current">{activeLabel}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <nav aria-label="Primary (mobile)">
        <p class="m-group">Get started</p>
        <ul>
          {doItems.map((it) => (
            <li>
              <a href={it.href} class:list={[{ active: it.slug === active }, { "nav-cta": it.slug === "start" }]}>{it.label}</a>
            </li>
          ))}
        </ul>
        <p class="m-group">
          <span class="lens-academic">Explore the field</span>
          <span class="lens-practitioner">Go deeper · optional</span>
        </p>
        <ul>
          {exploreItems.map((it) => (
            <li>
              <a href={it.href} class:list={[{ active: it.slug === active }]}>{it.label}</a>
            </li>
          ))}
        </ul>
        <ul>
          {metaItems.map((it) => (
            <li>
              <a href={it.href} class:list={[{ active: it.slug === active }]}>{it.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const audienceButtons = document.querySelectorAll<HTMLButtonElement>("[data-audience-mode]");
  const audienceStorageKey = "lec-audience-mode";

  function setAudienceMode(mode: "academic" | "practitioner") {
    document.documentElement.dataset.audience = mode;
    audienceButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.audienceMode === mode));
    });
  }

  const savedAudience = localStorage.getItem(audienceStorageKey);
  setAudienceMode(savedAudience === "practitioner" ? "practitioner" : "academic");

  audienceButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.audienceMode === "practitioner" ? "practitioner" : "academic";
      localStorage.setItem(audienceStorageKey, mode);
      setAudienceMode(mode);
    });
  });
</script>

<style>
  .site-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .nav-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: .75rem var(--page-pad);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    color: var(--ink);
    border: none;
    font-family: var(--serif);
    flex-shrink: 0;
  }
  .brand-mark {
    display: inline-grid;
    place-items: center;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 .35rem;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--sans);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .02em;
    border-radius: 2px;
  }
  .brand-text { font-size: 1rem; font-weight: 600; white-space: nowrap; }

  /* ── Desktop nav (hidden below 900px) ─────────────────────────────────── */
  .desktop-nav { display: none; }
  .nav-list {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: .1rem;
    justify-content: flex-end;
  }
  /* Thin divider + micro-label that mark the "explore/research" group so the
     six map/reading views read as one cluster, not six competing tabs. */
  .nav-sep { flex: 0 0 auto; width: 1px; height: 1.1rem; background: var(--border); margin: 0 .35rem; }
  .nav-group-label {
    flex: 0 0 auto;
    font-family: var(--sans);
    font-size: .58rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    margin-right: .1rem;
  }
  /* Practitioner lens: soften the research group so the do-it links lead. */
  :global(html[data-audience="practitioner"]) .nav-list--explore a { color: var(--muted); }
  :global(html[data-audience="practitioner"]) .nav-list--explore a.active { color: var(--accent); }
  /* Lens copy toggle (academic default; practitioner alternate). */
  .lens-practitioner { display: none; }
  :global(html[data-audience="practitioner"]) .lens-academic { display: none; }
  :global(html[data-audience="practitioner"]) .lens-practitioner { display: inline; }
  .desktop-nav a {
    font-family: var(--sans);
    font-size: .85rem;
    color: var(--ink-soft);
    border: none;
    padding: .35rem .65rem;
    border-radius: 3px;
    white-space: nowrap;
  }
  .desktop-nav a:hover { background: var(--tint); color: var(--accent); }
  /* "Start" is the practitioner front door — keep it visually primary. */
  .desktop-nav a.nav-cta { color: var(--accent); font-weight: 700; }
  .desktop-nav a.nav-cta:hover { background: var(--tint-warm); }
  .mobile-nav nav a.nav-cta { color: var(--accent); font-weight: 700; }
  .desktop-nav a.active {
    color: var(--accent);
    background: var(--tint-warm);
  }

  .audience-toggle {
    display: inline-flex;
    align-items: center;
    gap: .15rem;
    padding: .2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--tint);
    font-family: var(--sans);
  }
  .audience-label { padding: 0 .3rem; color: var(--muted); font-size: .67rem; white-space: nowrap; }
  .audience-toggle button {
    border: 0;
    border-radius: 999px;
    padding: .27rem .5rem;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    font: inherit;
    font-size: .7rem;
    white-space: nowrap;
  }
  .audience-toggle button[aria-pressed="true"] { background: var(--accent); color: #fff; }
  .audience-toggle button:hover { color: var(--accent); }
  .audience-toggle button[aria-pressed="true"]:hover { color: #fff; }

  /* ── Mobile nav (visible below 900px) ─────────────────────────────────── */
  .mobile-nav {
    width: 100%;
    flex: 0 0 100%;
    display: flex;
    justify-content: flex-start;
    position: relative;
  }
  @media (max-width: 899px) {
    .audience-toggle { margin-left: auto; }
  }
  .mobile-nav summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .65rem;
    font-family: var(--sans);
    font-size: .82rem;
    color: var(--ink-soft);
    background: var(--tint);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    margin-left: 0;
    user-select: none;
    white-space: nowrap;
  }
  .mobile-nav summary::-webkit-details-marker { display: none; }
  .mobile-nav summary .current {
    font-weight: 500;
    color: var(--accent);
    letter-spacing: .02em;
  }
  .mobile-nav[open] summary {
    background: var(--tint-warm);
    border-color: var(--accent);
    color: var(--accent);
  }
  .mobile-nav nav {
    position: absolute;
    left: 0;
    top: calc(100% + .45rem);
    width: min(19rem, calc(100vw - (var(--page-pad) * 2)));
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(26, 29, 26, 0.12);
    overflow: hidden;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0; padding: 0;
    display: flex;
    flex-direction: column;
  }
  .mobile-nav nav a {
    display: block;
    font-family: var(--sans);
    font-size: .95rem;
    color: var(--ink-soft);
    border: none;
    padding: .6rem .5rem;
    border-bottom: 1px solid var(--border);
  }
  .mobile-nav nav a:hover { background: var(--tint); color: var(--accent); }
  .mobile-nav nav a.active {
    color: var(--accent);
    background: var(--tint-warm);
    font-weight: 600;
  }
  /* Mobile group headings that label each nav cluster. */
  .m-group {
    margin: 0;
    padding: .5rem .5rem .25rem;
    font-family: var(--sans);
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    background: var(--tint);
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 620px) {
    .brand-text {
      font-size: .9rem;
      max-width: 13ch;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  @media (max-width: 460px) {
    .brand-text { display: none; }
    .nav-inner { gap: .55rem; }
    .mobile-nav summary { padding: .35rem .5rem; }
    .mobile-nav summary .current { display: none; }
    .mobile-nav nav { width: min(16rem, calc(100vw - (var(--page-pad) * 2))); }
  }

  /* ── Swap at 900px ────────────────────────────────────────────────────── */
  @media (min-width: 900px) {
    .nav-inner { flex-wrap: nowrap; }
    .desktop-nav { display: flex; align-items: center; flex-wrap: wrap; justify-content: flex-end; gap: .1rem .15rem; }
    .mobile-nav  { display: none; }
  }
</style>
