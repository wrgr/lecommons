---
// Shared page shell: metadata, global styles, nav, footer. Every page — the
// homepage included — renders on the light "reference index" shell.
import NavBar from "../components/NavBar.astro";
import LensChooser from "../components/LensChooser.astro";

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = "Learning Engineering Commons — the field's shared, topic-linked evidence corpus of practice, tools, reading list, events, and community.",
  active,
} = Astro.props;

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={base + "favicon.svg"} />
    <script is:inline>
      // Set the audience/lens attribute before first paint so the practitioner
      // theme (fonts, spacing, accent) never flashes in as the academic default.
      // Any stored value other than "practitioner" resolves to the researcher
      // (internally "academic") lens, so legacy/garbage values stay safe.
      try {
        var m = localStorage.getItem("lec-audience-mode");
        document.documentElement.dataset.audience = m === "practitioner" ? "practitioner" : "academic";
      } catch (e) {
        document.documentElement.dataset.audience = "academic";
      }
    </script>
    <slot name="head" />
  </head>
  <body>
    <NavBar active={active} />
    <LensChooser />
    <main>
      <slot />
    </main>
    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <strong>Learning Engineering Commons</strong>
          <span class="muted"> · curated resources adapted from IEEE ICICLE and other community sources, with credit. To include, modify, or exclude your content, please <a href="mailto:wgr@jhu.edu">reach out</a>!</span>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href={base + "about/"}>About this site</a>
          <a href="https://wrgr.github.io/lebokai/" target="_blank" rel="noopener">LEBoK</a>
          <a href="https://sagroups.ieee.org/icicle/" target="_blank" rel="noopener">IEEE ICICLE</a>
        </nav>
      </div>
      <div class="footer-copy">© 2026</div>
    </footer>

    <style is:global>
      :root {
        /* Cool "reference index" palette — deliberately distinct from
           capabilitymatters' warm cream/brown editorial theme. --tint-warm
           keeps its name (used as the "highlighted/active" tint throughout
           the component library) even though the value is no longer warm.
           This is the RESEARCHER (internally "academic") lens: dense serif. */
        --bg:        #f6f7f6;
        --ink:       #14161a;
        --ink-soft:  #2b2f36;
        --muted:     #656d78;
        --accent:    #35507a;
        --accent-2:  #6b4fa0;
        --border:    #dfe2e6;
        --tint:      #eef1f4;
        --tint-warm: #e6e9f5;

        --serif: "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
        --sans:  "Trebuchet MS", "Segoe UI", Verdana, sans-serif;
        --mono:  ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;

        /* Indirection tokens the two lenses re-point. Body/heading fonts and
           line-height flow through these so the practitioner override below can
           reshape the whole site's typography without touching every rule. */
        --font-body: var(--serif);
        --font-head: var(--serif);
        --line: 1.6;

        --measure: 38rem;
        --page-pad: clamp(1rem, 4vw, 2.5rem);
      }

      /* PRACTITIONER lens: a plainer, roomier, warmer treatment — sans-serif
         body + headings, taller line-height, a warmer high-contrast accent, and
         a larger base rem so every rem-based size scales up at once (bigger
         type, more whitespace, lower density). Researcher keeps the :root
         defaults untouched. Set pre-paint by the inline <head> script. */
      html[data-audience="practitioner"] {
        --font-body: var(--sans);
        --font-head: var(--sans);
        --line: 1.75;
        --accent:    #b4531f;
        --accent-2:  #7a3d12;
        --tint-warm: #f7e9dd;
        font-size: 106.25%;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      html { overflow-x: hidden; }
      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--font-body);
        line-height: var(--line);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      img, svg, video { max-width: 100%; height: auto; }
      h1, h2, h3, h4, p, li, blockquote, td, th { overflow-wrap: break-word; }
      a { overflow-wrap: anywhere; }

      a { color: var(--accent); text-decoration: none; border-bottom: 1px solid transparent; transition: border-color .15s ease; }
      a:hover { border-bottom-color: var(--accent); }

      table {
        display: block;
        width: 100%;
        max-width: 100%;
        border-collapse: collapse;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        font-family: var(--sans);
        font-size: .9rem;
        line-height: 1.4;
      }
      th, td {
        border: 1px solid var(--border);
        padding: .45rem .55rem;
        text-align: left;
        vertical-align: top;
      }
      th { background: var(--tint); font-weight: 600; }

      pre {
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        padding: .7rem .8rem;
        border: 1px solid var(--border);
        border-radius: 4px;
        background: var(--tint);
      }
      code {
        font-family: var(--mono);
        font-size: .9em;
      }

      main { min-height: calc(100vh - 120px); padding-bottom: 4rem; }

      h1, h2, h3, h4 {
        font-family: var(--font-head);
        font-weight: 600;
        line-height: 1.2;
        color: var(--ink);
        margin: 0 0 .6em 0;
      }
      h1 { font-size: clamp(2rem, 5vw, 3rem); letter-spacing: -0.01em; }
      h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); }
      h3 { font-size: 1.15rem; font-weight: 600; }

      p { margin: 0 0 1em 0; max-width: var(--measure); }
      .muted { color: var(--muted); }

      /* Lens-scoped content. Works at section and item level. Researcher is the
         default lens, so .lens-only--researcher shows by default and hides under
         the practitioner lens; .lens-only--practitioner is the mirror. `revert`
         restores the element's native display (block, inline, grid, …). Use
         these to expose genuinely different resources per lens — e.g. citations,
         concept ontology and Bloom levels for researchers; how-to and
         adapt-to-your-setting guidance for practitioners. */
      .lens-only--practitioner { display: none; }
      html[data-audience="practitioner"] .lens-only--researcher { display: none; }
      html[data-audience="practitioner"] .lens-only--practitioner { display: revert; }

      .eyebrow {
        font-family: var(--sans);
        font-size: .75rem;
        letter-spacing: .18em;
        text-transform: uppercase;
        color: var(--accent);
        margin: 0 0 1rem 0;
      }

      .container {
        max-width: 60rem;
        margin: 0 auto;
        padding: 2.5rem var(--page-pad);
      }

      .container-wide {
        max-width: 72rem;
        margin: 0 auto;
        padding: 2.5rem var(--page-pad);
      }

      hr.rule {
        border: none;
        border-top: 1px solid var(--border);
        margin: 2.5rem 0;
      }

      footer {
        border-top: 1px solid var(--border);
        background: var(--tint);
        margin-top: 4rem;
      }
      .footer-inner {
        max-width: 72rem;
        margin: 0 auto;
        padding: 1.25rem var(--page-pad);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        font-family: var(--sans);
        font-size: .85rem;
      }
      .footer-brand strong { font-family: var(--serif); font-weight: 600; }
      .footer-links { display: flex; gap: 1.2rem; }
      .footer-links a { color: var(--muted); border: none; }
      .footer-links a:hover { color: var(--accent); }
      .footer-copy {
        max-width: 72rem;
        margin: 0 auto;
        padding: 0 var(--page-pad) 1rem;
        font-family: var(--sans);
        font-size: .75rem;
        color: var(--muted);
        letter-spacing: .04em;
      }
    </style>
  </body>
</html>
